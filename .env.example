# Database connection (defaults match docker-compose.yml)
# Either set a single DATABASE_URL...
# DATABASE_URL=postgresql://training_user:training_pass@localhost:5434/training_hub

# ...or the discrete pieces (DATABASE_URL wins if both are set)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=training_hub
DB_USER=training_user
DB_PASSWORD=training_pass

# Strava API (Phase 2 — not yet wired up)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
