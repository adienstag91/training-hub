# Database connection (defaults match docker-compose.yml)
# Either set a single DATABASE_URL...
# DATABASE_URL=postgresql://training_user:training_pass@localhost:5434/training_hub

# ...or the discrete pieces (DATABASE_URL wins if both are set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=training_hub
POSTGRES_USER=training_user
POSTGRES_PASSWORD=training_pass

# Strava API (create an app at https://www.strava.com/settings/api)
# Run `python src/strava/strava_auth.py` once to populate the tokens below.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=
# STRAVA_EXPIRES_AT=

# Webhook server
# PORT=5000
# STRAVA_AUTO_PUBLISH=true   # set false to ingest without publishing
# FLASK_DEBUG=false
